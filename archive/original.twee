:: StoryScript [script]
let translations = {};
let translationsReady = false;

async function loadLanguage(lang) {
  try {
    const response = await fetch(`i18n/${lang}.json`);

    if (!response.ok) {
      throw new Error(`Could not load i18n/${lang}.json`);
    }

    translations = await response.json();
    translationsReady = true;

    applyTranslations();
    updateLanguageDropdown();

  } catch (error) {
    console.error("Language loading failed:", error);
    alert(`Could not load language file: i18n/${lang}.json`);
  }
}

window.setLanguage = async function (lang) {
  localStorage.setItem("language", lang);
  await loadLanguage(lang);
  applyTranslationsSoon();
};

function applyTranslations() {
  if (!translationsReady) return;

  document.querySelectorAll("[data-i18n]").forEach(element => {
    const key = element.getAttribute("data-i18n");
    element.textContent = translations[key] || `[missing: ${key}]`;
  });
}

function updateLanguageDropdown() {
  document.querySelectorAll("[data-language-select]").forEach(select => {
    select.value = localStorage.getItem("language") || "en";
  });
}

function applyTranslationsSoon() {
  applyTranslations();
  updateLanguageDropdown();

  setTimeout(applyTranslations, 50);
  setTimeout(applyTranslations, 150);
  setTimeout(applyTranslations, 300);

  setTimeout(updateLanguageDropdown, 50);
  setTimeout(updateLanguageDropdown, 150);
  setTimeout(updateLanguageDropdown, 300);
}

document.addEventListener("DOMContentLoaded", () => {
  const lang = localStorage.getItem("language") || "en";
  loadLanguage(lang).then(applyTranslationsSoon);
});

window.addEventListener("display-change", applyTranslationsSoon);
window.addEventListener("state-change", applyTranslationsSoon);

:: StoryStylesheet [stylesheet]
html, body, #page, #passages {
    font-family: Helvetica, Arial, sans-serif !important;
}

#page footer {
    padding-bottom: 50px;
}

#page header {
    padding-top: 10px;
    padding-bottom: 0px !important;
}

.policy {
  background-color: cyan !important;
  padding: 2px 6px;
  border-radius: 4px;
}

.tech {
  background-color: yellow !important;
  padding: 2px 6px;
  border-radius: 4px;
}

.event {
  background-color: magenta !important;
  padding: 2px 6px;
  border-radius: 4px;
}

/* FORCE BLACK LINK TEXT */
#page .policy,
#page .policy *,
#page .event,
#page .event *,
#page .tech,
#page .tech * {
  color: black !important;
}


.policy *:hover,
.event *:hover,
.tech *:hover {
  background-color: white !important;
  color: black !important;
}