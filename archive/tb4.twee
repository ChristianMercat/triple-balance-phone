:: StoryScript [script]
/* Reusable effect-row presentation, adapted from tribalance3.twee. */
engine.extend('2.3.1', () => {
  const metricIcons = {
    circularity: 'images/circularity.webp',
    happiness: 'images/good.webp',
    budget: 'images/money.webp'
  };

  const trendIcons = {
    up: 'images/up.webp',
    down: 'images/down.webp',
    unchanged: 'images/nochange.webp'
  };

  const escapeHtml = value => String(value)
    .replaceAll('&', '&amp;')
    .replaceAll('<', '&lt;')
    .replaceAll('>', '&gt;')
    .replaceAll('"', '&quot;')
    .replaceAll("'", '&#39;');

  const metricImage = metric => {
    const source = metricIcons[metric];

    if (!source) {
      throw new Error(`Unknown metric in component: ${metric}`);
    }

    return `<img class="metric-icon" src="${source}" alt="">`;
  };

  engine.template.inserts.add({
    match: /^effect row$/i,
    render(metric, props) {
      const trend = String(props.trend).toLowerCase();
      const trendSource = trendIcons[trend];

      if (!trendSource) {
        throw new Error(`Unknown trend in effect row: ${trend}`);
      }

      const firstClass = props.first ? ' effect-row-first' : '';

      return `<div class="effect-row${firstClass}">
        <div class="effect-icons">
          ${metricImage(String(metric).toLowerCase())} :
          <img class="trend-icon" src="${trendSource}" alt="">
        </div>
        <div class="effect-text">${escapeHtml(props.text)}</div>
      </div>`;
    }
  });
});

/* Connect passage tags to layouts after Chapbook inserts the new body. */
engine.extend("2.3.1", () => {
  const types = ["intro", "explanation", "round", "policy", "event", "outcome", "ending", "technology"];

  function applyPassageLayout(event) {
    const article = event.target;
    if (!(article instanceof HTMLElement) || !article.matches("#page article")) return;
    const passage = engine.story.passageNamed(engine.state.get("passage.name"));
    const tags = passage?.tags || [];
    const type = types.find(value => tags.includes(value));
    types.forEach(value => article.classList.remove(`passage-${value}`));
    article.classList.toggle("passage-prose", tags.includes("prose"));
    if (type) article.classList.add(`passage-${type}`);
    article.dataset.passageType = type || "";
  }

  window.addEventListener("body-content-change", applyPassageLayout);
});

let translations = {};
let translationsReady = false;

async function loadLanguage(lang) {
  try {
    const response = await fetch(`i18n/${lang}.json`);

    if (!response.ok) {
      throw new Error(`Could not load i18n/${lang}.json`);
    }

    translations = await response.json();
    translationsReady = true;

    applyTranslations();
    updateLanguageDropdown();

  } catch (error) {
    console.error("Language loading failed:", error);
    alert(`Could not load language file: i18n/${lang}.json`);
  }
}

window.setLanguage = async function (lang) {
  localStorage.setItem("language", lang);
  await loadLanguage(lang);
  applyTranslationsSoon();
};

function applyTranslations() {
  if (!translationsReady) return;

  document.querySelectorAll("[data-i18n]").forEach(element => {
    const key = element.getAttribute("data-i18n");
    element.textContent = translations[key] || `[missing: ${key}]`;
  });
}

function updateLanguageDropdown() {
  document.querySelectorAll("[data-language-select]").forEach(select => {
    select.value = localStorage.getItem("language") || "en";
  });
}

function applyTranslationsSoon() {
  applyTranslations();
  updateLanguageDropdown();

  setTimeout(applyTranslations, 50);
  setTimeout(applyTranslations, 150);
  setTimeout(applyTranslations, 300);

  setTimeout(updateLanguageDropdown, 50);
  setTimeout(updateLanguageDropdown, 150);
  setTimeout(updateLanguageDropdown, 300);
}

document.addEventListener("DOMContentLoaded", () => {
  const lang = localStorage.getItem("language") || "en";
  loadLanguage(lang).then(applyTranslationsSoon);
});

window.addEventListener("display-change", applyTranslationsSoon);
window.addEventListener("state-change", applyTranslationsSoon);

:: StoryStylesheet [stylesheet]
html, body, #page, #passages {
    font-family: Helvetica, Arial, sans-serif !important;
}

#page footer {
    padding-bottom: 50px;
}

#page header {
    padding-top: 10px;
    padding-bottom: 0px !important;
}

.policy {
  background-color: cyan !important;
  padding: 2px 6px;
  border-radius: 4px;
}

.tech {
  background-color: yellow !important;
  padding: 2px 6px;
  border-radius: 4px;
}

.event {
  background-color: magenta !important;
  padding: 2px 6px;
  border-radius: 4px;
}

/* FORCE BLACK LINK TEXT */
#page .policy,
#page .policy *,
#page .event,
#page .event *,
#page .tech,
#page .tech * {
  color: black !important;
}


.policy *:hover,
.event *:hover,
.tech *:hover {
  background-color: white !important;
  color: black !important;
}

/* Shared presentation classes (tb1). */
#page .text-center {
  text-align: center;
}

#page .no-wrap,
#page .effect-icons {
  white-space: nowrap;
}

#page .full-width,
#page .effect-text {
  width: 100%;
}

#page .tight-lines {
  line-height: 1;
}

#page .indicator-row,
#page .effect-row {
  display: grid;
  grid-template-columns: 60px 1fr;
  column-gap: 20px;
  width: 100%;
  margin-bottom: 10px;
  align-items: start;
}

#page .indicator-row-summary {
  grid-template-columns: 80px 1fr;
  margin-bottom: 0;
  align-items: center;
}

#page .indicator-row-first,
#page .effect-row-first {
  margin-top: 12px;
}

#page .indicator-icon,
#page .metric-icon,
#page .trend-icon {
  height: 25px;
  position: relative;
  top: 5px;
}

#page .indicator-icon-offset-3 {
  top: 3px;
}

#page .score-icon {
  height: 50px;
  position: relative;
  top: 3px;
  right: 5px;
}

#page .balance-illustration {
  height: 103px;
  position: relative;
  top: 5px;
  left: 0;
}

#page .story-illustration {
  height: 150px;
  position: relative;
  top: 5px;
  left: 10px;
}


/* Tag-driven passage layouts (tb3).
   Passage tags select these article classes through StoryScript.
   Add the prose tag when a passage needs left-aligned reading text. */
#page article.passage-intro,
#page article.passage-round,
#page article.passage-event,
#page article.passage-ending,
#page article.passage-technology {
  text-align: center;
}

#page article.passage-explanation,
#page article.passage-policy,
#page article.passage-outcome,
#page article.passage-prose {
  text-align: left;
}

#page article .passage-title,
#page article .passage-navigation {
  text-align: center;
}

/* Indicator descriptions stay readable inside centered passage types. */
#page article .indicator-row,
#page article .effect-row {
  text-align: left;
}
