:: StoryScript [script]
let translations = {};
let translationsReady = false;

async function loadLanguage(lang) {
  try {
    const response = await fetch(`i18n/${lang}.json`);

    if (!response.ok) {
      throw new Error(`Could not load i18n/${lang}.json`);
    }

    translations = await response.json();
    translationsReady = true;

    applyTranslations();
    updateLanguageDropdown();

  } catch (error) {
    console.error("Language loading failed:", error);
    alert(`Could not load language file: i18n/${lang}.json`);
  }
}

window.setLanguage = async function (lang) {
  localStorage.setItem("language", lang);
  await loadLanguage(lang);
  applyTranslationsSoon();
};

function applyTranslations() {
  if (!translationsReady) return;

  document.querySelectorAll("[data-i18n]").forEach(element => {
    const key = element.getAttribute("data-i18n");
    element.textContent = translations[key] || `[missing: ${key}]`;
  });
}

function updateLanguageDropdown() {
  document.querySelectorAll("[data-language-select]").forEach(select => {
    select.value = localStorage.getItem("language") || "en";
  });
}

function applyTranslationsSoon() {
  applyTranslations();
  updateLanguageDropdown();

  setTimeout(applyTranslations, 50);
  setTimeout(applyTranslations, 150);
  setTimeout(applyTranslations, 300);

  setTimeout(updateLanguageDropdown, 50);
  setTimeout(updateLanguageDropdown, 150);
  setTimeout(updateLanguageDropdown, 300);
}

document.addEventListener("DOMContentLoaded", () => {
  const lang = localStorage.getItem("language") || "en";
  loadLanguage(lang).then(applyTranslationsSoon);
});

window.addEventListener("display-change", applyTranslationsSoon);
window.addEventListener("state-change", applyTranslationsSoon);

// Reusable presentation components. Keeping these behind small Chapbook inserts
// makes the story passages declarative and gives a later SugarCube port a clear
// set of components to reimplement.
engine.extend('2.3.0', () => {
  const metricIcons = {
    circularity: 'images/circularity.webp',
    happiness: 'images/good.webp',
    budget: 'images/money.webp'
  };

  const trendIcons = {
    up: 'images/up.webp',
    down: 'images/down.webp',
    unchanged: 'images/nochange.webp'
  };

  const escapeHtml = value => String(value)
    .replaceAll('&', '&amp;')
    .replaceAll('<', '&lt;')
    .replaceAll('>', '&gt;')
    .replaceAll('"', '&quot;')
    .replaceAll("'", '&#39;');

  const metricImage = metric => {
    const source = metricIcons[metric];

    if (!source) {
      throw new Error(`Unknown metric in component: ${metric}`);
    }

    return `<img class="metric-icon" src="${source}" alt="">`;
  };

  engine.template.inserts.add({
    match: /^effect row$/i,
    render(metric, props) {
      const trend = String(props.trend).toLowerCase();
      const trendSource = trendIcons[trend];

      if (!trendSource) {
        throw new Error(`Unknown trend in effect row: ${trend}`);
      }

      const firstClass = props.first ? ' effect-row-first' : '';

      return `<div class="effect-row${firstClass}">
        <div class="effect-icons">
          ${metricImage(String(metric).toLowerCase())} :
          <img class="trend-icon" src="${trendSource}" alt="">
        </div>
        <div class="effect-text">${escapeHtml(props.text)}</div>
      </div>`;
    }
  });

  engine.template.inserts.add({
    match: /^status row$/i,
    render(metric, props) {
      const firstClass = props.first ? ' effect-row-first' : '';

      return `<div class="effect-row${firstClass}">
        <div class="effect-icons">
          ${metricImage(String(metric).toLowerCase())} = ${escapeHtml(props.value)}
        </div>
        <div class="effect-text">${escapeHtml(props.text)}</div>
      </div>`;
    }
  });

  const stateNumber = name => Number(engine.state.get(name));

  const continueLink = destination => {
    if (typeof destination !== 'string' || destination.length === 0) {
      throw new Error('A continuation destination is required.');
    }

    return `<div class="centered">
      <passage-link class="link" to="${escapeHtml(destination)}">Continue</passage-link>
    </div>`;
  };

  const guardedDestination = destination => {
    const happiness = stateNumber('happy');
    const budget = stateNumber('money');

    if (happiness < 1) {
      return 'Game over';
    }

    if (happiness > 0 && budget === 0) {
      return 'Game over2';
    }

    return happiness > 0 && budget > 0 ? destination : null;
  };

  engine.template.inserts.add({
    match: /^continue to$/i,
    render(destination) {
      const target = guardedDestination(destination);
      return target ? continueLink(target) : '';
    }
  });

  engine.template.inserts.add({
    match: /^continue with events$/i,
    render(fallback, props) {
      const guarded = guardedDestination(fallback);

      if (guarded !== fallback) {
        return guarded ? continueLink(guarded) : '';
      }

      const event = stateNumber('randomEvent');
      const group = Number(props.group);
      const target = event >= 1 && event <= 3
        ? `Event${group}.${event}`
        : fallback;

      return continueLink(target);
    }
  });

  engine.template.inserts.add({
    match: /^continue with technology$/i,
    render(fallback, props) {
      const happiness = stateNumber('happy');
      const budget = stateNumber('money');
      const technologies = stateNumber('tech');
      const release = String(props.release);

      // The original first technology checkpoint checked happy == 0,
      // whereas the later checkpoints checked happy < 1. Preserve that rule.
      const gameIsOver = release === 'NewTech1'
        ? happiness === 0
        : happiness < 1;

      if (gameIsOver) {
        return continueLink('Game over');
      }

      if (happiness > 0 && budget === 0) {
        return continueLink('Game over2');
      }

      if (happiness > 0 && budget > 0 && technologies > 0) {
        return continueLink(release);
      }

      if (happiness > 0 && budget > 0 && technologies === 0) {
        return continueLink(fallback);
      }

      return '';
    }
  });

  engine.template.inserts.add({
    match: /^continue after technology$/i,
    render(destination) {
      return continueLink(
        stateNumber('happy') < 1 ? 'Game over' : destination
      );
    }
  });
});

:: StoryStylesheet [stylesheet]
html, body, #page, #passages {
    font-family: Helvetica, Arial, sans-serif !important;
}

#page footer {
    padding-bottom: 50px;
}

#page header {
    padding-top: 10px;
    padding-bottom: 0px !important;
}

.policy {
  background-color: cyan !important;
  padding: 2px 6px;
  border-radius: 4px;
}

.tech {
  background-color: yellow !important;
  padding: 2px 6px;
  border-radius: 4px;
}

.event {
  background-color: magenta !important;
  padding: 2px 6px;
  border-radius: 4px;
}

/* FORCE BLACK LINK TEXT */
#page .policy,
#page .policy *,
#page .event,
#page .event *,
#page .tech,
#page .tech * {
  color: black !important;
}


.policy *:hover,
.event *:hover,
.tech *:hover {
  background-color: white !important;
  color: black !important;
}
/* Reusable story layout components. */
.centered {
  text-align: center;
}

.effect-row,
.summary-row {
  display: grid;
  grid-template-columns: 60px 1fr;
  column-gap: 20px;
  width: 100%;
  margin-bottom: 10px;
  align-items: start;
}

.effect-row-first {
  margin-top: 12px;
}

.effect-icons,
.summary-icons {
  white-space: nowrap;
}

.effect-text,
.summary-text {
  width: 100%;
}

.summary-row {
  grid-template-columns: 80px 1fr;
  margin-bottom: 0;
  align-items: center;
}

.summary-text {
  line-height: 1;
}

.metric-icon,
.trend-icon {
  height: 25px;
  position: relative;
  top: 5px;
}
