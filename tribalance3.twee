:: LIMIT ONLINE FOOTPRINT\  {"position":"850,1725","size":"100,100"}
happy: happy - 1
circle: circle + 1
config.footer.center: ""
--
<div class="centered">
<b>LIMIT ONLINE FOOTPRINT</b><br>
</div>

{effect row: "circularity", trend: "up", text: "people use phones less and upgrade less often", first: true}

{effect row: "happiness", trend: "down", text: "users find the restrictions annoying or limiting"}

{continue with technology: "End1", release: "NewTech3"}


:: LOW-ORBIT SIGNAL MESH {"position":"550,800","size":"100,100"}
happy: happy +1
tech: tech -1
config.footer.center: ""
--
<div class="centered">
<b>LOW-ORBIT SIGNAL MESH</b><br>
