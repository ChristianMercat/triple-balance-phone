:: StoryTitle
TriBalance3

:: StoryData
{
  "ifid": "C9767237-F3CD-4823-9E0B-A753FC120540",
  "format": "Chapbook",
  "format-version": "2.3.1",
  "start": "Start",
  "zoom": 1
}


:: 1.1Fire {"position":"1300,550","size":"100,100"}
circle: Math.max(0, circle - 1)
--
<div class="centered">
<b>The recycling plant burns down.</b><br>
</div>

{effect row: "circularity", trend: "down", text: "less ability to recycle old smartphones and materials", first: true}

{continue to: "Round2"}



:: 1.1OutFire {"position":"1175,550","size":"100,100"}
money: money - 1
--
<div class="centered">
<b>You managed to stop the fire.</b><br>
</div>

{effect row: "circularity", trend: "unchanged", text: "thanks to your action, the circularity did not decrease", first: true}

{effect row: "budget", trend: "down", text: "the operation was paid from the city budget"}

{continue to: "Round2"}


:: 1.2bankrupt {"position":"1625,550","size":"100,100"}
circle: Math.max(0, circle - 1)
happy: happy - 1
--
<div class="centered">
<b>The supplier goes bankrupt.</b><br>
</div>

{effect row: "circularity", trend: "down", text: "fewer phones are repaired and kept in use", first: true}

{effect row: "happiness", trend: "down", text: "repairs become more expensive and inconvenient"}

{continue to: "Round2"}



:: 1.2save {"position":"1500,550","size":"100,100"}
money: money - 1
--
<div class="centered">
<b>Your aid keeps the supplier operating.</b><br>
</div>

{effect row: "circularity", trend: "unchanged", text: "thanks to your action, the circularity did not decrease", first: true}

{effect row: "budget", trend: "down", text: "financial aid was paid from the city budget"}

{continue to: "Round2"}


:: 1.3minimalism {"position":"1900,550","size":"100,100"}
circle: circle + 1
money: money - 1
--
<div class="centered">
<b>People own fewer devices.</b><br>
</div>

{effect row: "circularity", trend: "up", text: "fewer new phones are needed", first: true}

{effect row: "budget", trend: "down", text: "less tax revenue"}

{continue to: "Round2"}


:: 1.3spending {"position":"1775,550","size":"100,100"}
money: money - 1
--
<div class="centered">
<b>You promote new technology and upgrades.</b><br>
</div>

{effect row: "circularity", trend: "unchanged", text: "the positive effect is cancelled out by your actions", first: true}

{effect row: "budget", trend: "down", text: "money from the city budget was used"}

{continue to: "Round2"}


:: 2.1Reduce {"position":"1400,1050","size":"100,100"}
happy: happy - 1
--
<div class="centered">
<b>You restrict the launch of the new Pineapple Phone.</b><br>
</div>

{effect row: "circularity", trend: "unchanged", text: "not too many phones in use are replaced with the new model", first: true}

{effect row: "happiness", trend: "down", text: "people are disappointed they cannot easily get the newest features"}

{continue to: "Round4"}


:: 2.1Support {"position":"1250,1050","size":"100,100"}
happy: happy + 1
circle: Math.max(0, circle - 1)
money: money + 1
--
<div class="centered">
<b>Unrestricted launch of the new Pineapple Phone</b><br>
</div>

{effect row: "circularity", trend: "down", text: "more old phones are replaced sooner", first: true}

{effect row: "happiness", trend: "up", text: "latest technology is available"}

{effect row: "budget", trend: "up", text: "more new phones are sold, which generates additional tax revenue"}

{continue to: "Round4"}


:: 2.2cheap {"position":"1525,1050","size":"100,100"}
happy: happy + 1
circle: Math.max(0, circle - 1)
money: money - 1
--
<div class="centered">
<b>New phones are cheap.</b><br>
</div>

{effect row: "circularity", trend: "down", text: "older devices are replaced more quickly", first: true}

{effect row: "happiness", trend: "up", text: "lower phone prices"}

{effect row: "budget", trend: "down", text: "less tax is paid to the city, since products are cheaper"}

{continue to: "Round4"}


:: 2.2protect {"position":"1650,1050","size":"100,100"}
happy: happy - 1
money: money + 1
--
<div class="centered">
<b>You added tax to the cheap phones.</b><br>
</div>

{effect row: "circularity", trend: "unchanged", text: "people buy as many phones as before", first: true}

{effect row: "happiness", trend: "down", text: "new tax"}

{effect row: "budget", trend: "up", text: "additional tax revenue"}

{continue to: "Round4"}


:: 2.3RR {"position":"1825,1050","size":"100,100"}
happy: happy - 1
circle: circle + 2
money: money -1
--
<div class="centered">
<b>You encourage citizens to repair, reuse, and buy refurbished phones.</b><br>
</div>

{effect row: "circularity", trend: "up", text: "fewer new phones are purchased", first: true}

{effect row: "happiness", trend: "down", text: "lack of new devices"}

{effect row: "budget", trend: "down", text: "the campaign used money from the city budget"}

{continue to: "Round4"}


:: 2.3subsidize {"position":"1950,1050","size":"100,100"}
money: Math.max(0, money - 2)
--
<div class="centered">
<b>You subsidize new phone purchases.</b><br>
</div>

{effect row: "happiness", trend: "unchanged", text: "people remain as happy as before the chip crisis", first: true}

{effect row: "budget", trend: "down", text: "money from the city budget is used"}

{continue to: "Round4"}


:: 3.1regulate {"position":"1375,1325","size":"100,100"}
circle: Math.max(0, circle - 1)
--
<div class="centered">
<b>You require safer recycling methods and waste treatment.</b><br>
</div>

{effect row: "circularity", trend: "down", text: "fewer materials are processed in the short term", first: true}

{effect row: "happiness", trend: "unchanged", text: "your measures prevent a change in happiness"}

{effect row: "budget", trend: "unchanged", text: "recycling costs increase, but the city budget remains unchanged"}

{continue to: "Round5"}


:: 3.1toxic {"position":"1250,1325","size":"100,100"}
happy: happy - 1
money: money - 1
--
<div class="centered">
<b>Recycling operations keep running despite the risks.</b><br>
</div>

{effect row: "circularity", trend: "unchanged", text: "materials are still recycled", first: true}

{effect row: "happiness", trend: "down", text: "toxic waste harms the environment and public health"}

{effect row: "budget", trend: "down", text: "increased illness places a financial burden on the city budget"}

{continue to: "Round5"}


:: 3.2info {"position":"1675,1325","size":"100,100"}
circle: circle + 1
happy: happy + 1
money: money -1
--
<div class="centered">
<b>You launched a public information campaign.</b><br>
</div>

{effect row: "circularity", trend: "up", text: "more phones are donated, reused, and recycled", first: true}

{effect row: "happiness", trend: "up", text: "people feel more secure about their personal information (even more than before the event)"}

{effect row: "budget", trend: "down", text: "the campaign used money from the city budget"}

{continue to: "Round5"}


:: 3.2nothing {"position":"1550,1325","size":"100,100"}
circle: Math.max(0, circle - 1)
happy: happy - 1
--
<div class="centered">
<b>People are afraid to give away or recycle old devices.</b><br>
</div>

{effect row: "circularity", trend: "down", text: "fewer phones are reused, repaired, or recycled", first: true}

{effect row: "happiness", trend: "down", text: "fear of data theft"}

{continue to: "Round5"}


:: 3.3circular {"position":"1825,1325","size":"100,100"}
circle: circle + 2
money: money - 1
--
<div class="centered">
<b>You provide incentives for repair, reuse, and refurbishment.</b><br>
</div>

{effect row: "circularity", trend: "up", text: "phones and components stay in use longer", first: true}

{effect row: "happiness", trend: "unchanged", text: "affordable devices are accessible despite the recession"}

{effect row: "budget", trend: "down", text: "incentives are paid from the city budget"}

{continue to: "Round5"}


:: 3.3purchase {"position":"1950,1325","size":"100,100"}
money: money - 1
--
<div class="centered">
<b>You offer vouchers and tax reductions for new phones.</b><br>
</div>

{effect row: "circularity", trend: "unchanged", text: "replacement rates stay the same", first: true}

{effect row: "happiness", trend: "unchanged", text: "people still have access to new devices despite the recession"}

{effect row: "budget", trend: "down", text: "vouchers or tax reductions are paid from the city budget"}

{continue to: "Round5"}


:: BIO PHONE {"position":"725,1475","size":"100,100"}
circle: circle + 1
money: money - 1
config.footer.center: ""
--
<div class="centered">
<b>BIO PHONE</b><br>
</div>

{effect row: "circularity", trend: "up", text: "more environmentally friendly materials are used", first: true}

{effect row: "budget", trend: "down", text: "tax revenue is reduced"}

{continue with technology: "Round6", release: "NewTech2"}



:: BYOD {"position":"850,925","size":"100,100"}
circle: circle + 1
money: money - 1
config.footer.center: ""
randomEvent: (Math.floor((Math.random() * 1000 + Date.now()) % 4)) +1
--
<div class="centered">
<b>BYOD</b><br>
</div>

{effect row: "circularity", trend: "up", text: "the number of devices in use is reduced", first: true}

{effect row: "happiness", trend: "unchanged", text: "people are slightly happier because they only need one phone (too little to affect the index)"}

{effect row: "budget", trend: "down", text: "implementation costs and lower tax revenue from reduced device sales"}

{continue with events: "Round4", group: 2}


:: CLOSED-LOOP LAW {"position":"725,1725","size":"100,100"}
circle: circle + 1
config.footer.center: ""
--
<div class="centered">
<b>CLOSED-LOOP LAW</b><br>
</div>

{effect row: "circularity", trend: "up", text: "more materials are recovered and reused in new devices", first: true}

{effect row: "happiness", trend: "unchanged", text: "the policy has little direct impact on consumers"}

{continue with technology: "End1", release: "NewTech3"}


:: CONSUMPTION LIMIT {"position":"975,1475","size":"100,100"}
happy: happy - 2
circle: circle + 2
money: money - 1
config.footer.center: ""
--
<div class="centered">
<b>NO EXPLOITATIVE FEATURES</b><br>
</div>

{effect row: "circularity", trend: "up", text: "phones are kept and used for longer", first: true}

{effect row: "happiness", trend: "down", text: "people have less freedom to upgrade whenever they want"}

{effect row: "budget", trend: "down", text: "fewer phones are sold, resulting in lower tax revenue"}

{continue with technology: "Round6", release: "NewTech2"}



:: DON'T PHONE AND DRIVE {"position":"850,1200","size":"100,100"}
happy: happy - 1
config.footer.center: ""
randomEvent: (Math.floor((Math.random() * 1000 + Date.now()) % 4) ) +1
--
<div class="centered">
<b>DON'T PHONE AND DRIVE</b><br>
</div>

{effect row: "circularity", trend: "unchanged", text: "has little effect on phone purchases, repairs, or recycling", first: true}

{effect row: "happiness", trend: "down", text: "drivers face stricter rules and higher fines"}

{effect row: "budget", trend: "unchanged", text: "enforcement costs offset most of the revenue from penalties"}

{continue with events: "Round5", group: 3}


:: EXTREME ECO-TAX {"position":"850,425","size":"100,100"}
happy: happy - 2
circle: circle + 2
money: money + 2
config.footer.center: ""
randomEvent: (Math.floor((Math.random() * 1000 + Date.now()) % 4)) + 1
--
<div class="centered">
<b>EXTREME ECO-TAX</b><br>
</div>

{effect row: "circularity", trend: "up", text: "keep, repair, and reuse old phones is encouraged", first: true}

{effect row: "happiness", trend: "down", text: "prices increase"}

{effect row: "budget", trend: "up", text: "additional tax revenue"}

{continue with events: "Round2", group: 1}


