happy: happy - 1
randomEvent: (Math.floor((Math.random() * 1000 + Date.now()) % 4) ) +1
--
<div class="passage-title">
DON'T PHONE AND DRIVE
</div>

{effect row: "circularity", trend: "unchanged", text: "has little effect on phone purchases, repairs, or recycling", first: true}

{effect row: "happiness", trend: "down", text: "drivers face stricter rules and higher fines"}

{effect row: "budget", trend: "unchanged", text: "enforcement costs offset most of the revenue from penalties"}

<div class="passage-navigation">
[if randomEvent == 1]
[[Continue->Event3.1]]

