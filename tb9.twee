:: StoryScript [script]
/* Optional end-condition override. Normal route links stay visible to Twine. */
engine.extend("2.3.1", () => {
  engine.template.inserts.add({
    match: /^game over override$/i,
    render: () => '<div hidden data-game-over-override></div>'
  });

  function overrideContinueDestination(event) {
    const article = event.target;
    if (!(article instanceof HTMLElement) || !article.matches("#page article")) return;
    const happiness = Number(engine.state.get("happy"));
    const budget = Number(engine.state.get("money"));
    const destination = happiness <= 0 ? "Game over" : budget <= 0 ? "Game over2" : null;
    const visited = new Set();
    article.querySelectorAll("[data-game-over-override]").forEach(marker => {
      const navigation = marker.closest(".passage-navigation");
      if (!navigation || visited.has(navigation)) return;
      visited.add(navigation);
      navigation.querySelectorAll("passage-link").forEach(link => {
        if (link.textContent.trim() !== "Continue") return;
        // Retain the normal destination if the hook is invoked again on this body.
        if (!link.dataset.normalDestination) link.dataset.normalDestination = link.getAttribute("to");
        link.setAttribute("to", destination || link.dataset.normalDestination);
      });
    });
  }

  window.addEventListener("body-content-change", overrideContinueDestination);
});

/* Reusable effect-row presentation, adapted from tribalance3.twee. */
engine.extend('2.3.1', () => {
  const metricIcons = {
    circularity: 'images/circularity.webp',
    happiness: 'images/good.webp',
    budget: 'images/money.webp'
  };

  const trendIcons = {
    up: 'images/up.webp',
    down: 'images/down.webp',
    unchanged: 'images/nochange.webp'
  };

  const escapeHtml = value => String(value)
    .replaceAll('&', '&amp;')
    .replaceAll('<', '&lt;')
    .replaceAll('>', '&gt;')
    .replaceAll('"', '&quot;')
    .replaceAll("'", '&#39;');

  const metricImage = metric => {
    const source = metricIcons[metric];

    if (!source) {
      throw new Error(`Unknown metric in component: ${metric}`);
    }

    return `<img class="metric-icon" src="${source}" alt="">`;
  };

  engine.template.inserts.add({
    match: /^effect row$/i,
    render(metric, props) {
      const trend = String(props.trend).toLowerCase();
      const trendSource = trendIcons[trend];

      if (!trendSource) {
        throw new Error(`Unknown trend in effect row: ${trend}`);
      }

      const firstClass = props.first ? ' effect-row-first' : '';

      return `<div class="effect-row${firstClass}">
        <div class="effect-icons">
          ${metricImage(String(metric).toLowerCase())} :
          <img class="trend-icon" src="${trendSource}" alt="">
        </div>
        <div class="effect-text">${escapeHtml(props.text)}</div>
      </div>`;
    }
  });

  engine.template.inserts.add({
    match: /^status row$/i,
    render(metric, props) {
      const firstClass = props.first ? ' effect-row-first' : '';
      return `<div class="effect-row status-row${firstClass}">
        <div class="effect-icons">
          ${metricImage(String(metric).toLowerCase())} = ${escapeHtml(props.value)}
        </div>
        <div class="effect-text">${escapeHtml(props.text)}</div>
      </div>`;
    }
  });

  // Paired inserts keep conditional explanations in the passage source.
  engine.template.inserts.add({
    match: /^summary row$/i,
    render(metric, props) {
      const firstClass = props.first ? ' effect-row-first' : '';
      return `<div class="summary-row${firstClass}">
        <div class="summary-icons">
          ${metricImage(String(metric).toLowerCase())} = ${escapeHtml(props.value)}
        </div>
        <div class="summary-text">`;
    }
  });

  engine.template.inserts.add({
    match: /^end summary row$/i,
    render: () => '</div></div>'
  });


  /* Resolve UI settings from this passage's vars section, never inherited state.
     Settings are JSON literals; strings can contain normal Twine links/inserts. */
  const uiModesByTag = {
    intro: 'intro', explanation: 'intro', round: 'round',
    policy: 'gameplay', event: 'gameplay', outcome: 'gameplay',
    technology: 'gameplay', ending: 'results'
  };

  function passageUiSettings(passage) {
    const separator = /^--\s*$/m.exec(passage.source);
    const vars = separator ? passage.source.slice(0, separator.index) : '';
    const settings = {};
    for (const line of vars.split('\n')) {
      const match = /^ui\.(mode|round|status|skip|headerRight|footerLeft|footerCenter|footerRight):\s*(.+)$/.exec(line);
      if (match) settings[match[1]] = JSON.parse(match[2]);
    }
    return settings;
  }

  function renderUiControls(source) {
    return source ? `<div class="ui-controls">${engine.template.render(source)}</div>` : '';
  }

  function uiMetric(metric, value) {
    return `<span class="ui-metric">${metricImage(metric)}<span>: ${escapeHtml(value)}</span></span>`;
  }

  function renderPassageUi(event) {
    const passage = engine.story.passageNamed(engine.state.get('passage.name'));
    if (!passage) return;
    const settings = passageUiSettings(passage);
    const tag = passage.tags.find(value => Object.hasOwn(uiModesByTag, value));
    const mode = settings.mode || uiModesByTag[tag] || 'gameplay';
    if (!['intro', 'gameplay', 'round', 'results', 'game-over'].includes(mode)) {
      throw new Error(`Unknown UI mode: ${mode}`);
    }
    const gameplay = mode === 'gameplay' || mode === 'round';
    const status = settings.status ?? gameplay;
    const skip = settings.skip ?? mode === 'intro';
    const footer = { left: '', center: '', right: '' };
    const header = {
      left: `<select data-language-select onchange="setLanguage(this.value)"><option value="en">English</option><option value="de">Deutsch</option></select>`,
      center: `<div class="ui-identity"><img class="ui-logo" src="images/happy_phone.png" alt=""><span class="ui-title-group"><span class="header-title" data-i18n="header.title"></span><br><span class="ui-subtitle" data-i18n="header.subtitle"></span></span></div>`,
      right: renderUiControls(settings.headerRight ?? (gameplay ? '[[Restart|Start]]' : ''))
    };
    if (status) {
      footer.left = `<div class="ui-status">${uiMetric('happiness', engine.state.get('happy'))}${uiMetric('budget', engine.state.get('money'))}</div>`;
      footer.right = `<div class="ui-status">${uiMetric('circularity', engine.state.get('circle'))}</div>`;
    }
    if (skip) {
      footer.right = `<passage-link class="link" to="Start5"><span data-i18n="footer.skipExplanations"></span></passage-link>`;
    }
    if (mode === 'round') {
      if (!Number.isInteger(settings.round) || settings.round < 1 || settings.round > 6) {
        throw new Error('Round UI requires ui.round between 1 and 6');
      }
      footer.center = `Round ${settings.round}/6`;
    }
    if (mode === 'results' || mode === 'game-over') {
      footer.center = renderUiControls('[[Restart|Start]] [[Credits->End.Credits]]');
    }
    for (const slot of ['left', 'center', 'right']) {
      const key = `footer${slot[0].toUpperCase()}${slot.slice(1)}`;
      if (Object.hasOwn(settings, key)) footer[slot] = renderUiControls(settings[key]);
    }
    // Chapbook updates its slots after inserting the body. Commit the complete
    // layout once that render finishes, without changing config or game state.
    queueMicrotask(() => {
      const page = document.querySelector('#page');
      for (const [name, slots] of Object.entries({ header, footer })) {
        const element = page.querySelector(`:scope > ${name}`);
        element.innerHTML = ['left', 'center', 'right']
          .map(slot => `<div class="${slot}">${slots[slot]}</div>`).join('');
        element.toggleAttribute('hidden', !Object.values(slots).some(Boolean));
      }
      page.dataset.uiMode = mode;
    });
  }

  document.addEventListener('body-content-change', renderPassageUi);

});

/* Connect passage tags to layouts after Chapbook inserts the new body. */
engine.extend("2.3.1", () => {
  const types = ["intro", "explanation", "round", "policy", "event", "outcome", "ending", "technology"];

  function applyPassageLayout(event) {
    const article = event.target;
    if (!(article instanceof HTMLElement) || !article.matches("#page article")) return;
    const passage = engine.story.passageNamed(engine.state.get("passage.name"));
    const tags = passage?.tags || [];
    const type = types.find(value => tags.includes(value));
    types.forEach(value => article.classList.remove(`passage-${value}`));
    article.classList.toggle("passage-prose", tags.includes("prose"));
    if (type) article.classList.add(`passage-${type}`);
    article.dataset.passageType = type || "";
  }

  window.addEventListener("body-content-change", applyPassageLayout);
});

let translations = {};
let translationsReady = false;

async function loadLanguage(lang) {
  try {
    const response = await fetch(`i18n/${lang}.json`);

    if (!response.ok) {
      throw new Error(`Could not load i18n/${lang}.json`);
    }

    translations = await response.json();
    translationsReady = true;

    applyTranslations();
    updateLanguageDropdown();

  } catch (error) {
    console.error("Language loading failed:", error);
    alert(`Could not load language file: i18n/${lang}.json`);
  }
}

window.setLanguage = async function (lang) {
  localStorage.setItem("language", lang);
  await loadLanguage(lang);
  applyTranslationsSoon();
};

function applyTranslations() {
  if (!translationsReady) return;

  document.querySelectorAll("[data-i18n]").forEach(element => {
    const key = element.getAttribute("data-i18n");
    element.textContent = translations[key] || `[missing: ${key}]`;
  });
}

function updateLanguageDropdown() {
  document.querySelectorAll("[data-language-select]").forEach(select => {
    select.value = localStorage.getItem("language") || "en";
  });
}

function applyTranslationsSoon() {
  applyTranslations();
  updateLanguageDropdown();

  setTimeout(applyTranslations, 50);
  setTimeout(applyTranslations, 150);
  setTimeout(applyTranslations, 300);

  setTimeout(updateLanguageDropdown, 50);
  setTimeout(updateLanguageDropdown, 150);
  setTimeout(updateLanguageDropdown, 300);
}

document.addEventListener("DOMContentLoaded", () => {
  const lang = localStorage.getItem("language") || "en";
  loadLanguage(lang).then(applyTranslationsSoon);
});

window.addEventListener("display-change", applyTranslationsSoon);
window.addEventListener("state-change", applyTranslationsSoon);

:: StoryStylesheet [stylesheet]
html, body, #page, #passages {
    font-family: Helvetica, Arial, sans-serif !important;
}

#page footer {
    padding-bottom: 50px;
}

#page header {
    padding-top: 10px;
    padding-bottom: 0px !important;
}

.policy {
  background-color: cyan !important;
  padding: 2px 6px;
  border-radius: 4px;
}

.tech {
  background-color: yellow !important;
  padding: 2px 6px;
  border-radius: 4px;
}

.event {
  background-color: magenta !important;
  padding: 2px 6px;
  border-radius: 4px;
}

/* FORCE BLACK LINK TEXT */
#page .policy,
#page .policy *,
#page .event,
#page .event *,
#page .tech,
#page .tech * {
  color: black !important;
}


.policy *:hover,
.event *:hover,
.tech *:hover {
  background-color: white !important;
  color: black !important;
}

/* Shared presentation classes (tb1). */
#page .no-wrap,
#page .effect-icons,
#page .summary-icons {
  white-space: nowrap;
}

#page .full-width,
#page .effect-text,
#page .summary-text {
  width: 100%;
}

#page .tight-lines,
#page .summary-text {
  line-height: 1;
}

#page .indicator-row,
#page .effect-row,
#page .summary-row {
  display: grid;
  grid-template-columns: 60px 1fr;
  column-gap: 20px;
  width: 100%;
  margin-bottom: 10px;
  align-items: start;
}

#page .indicator-row-summary,
#page .summary-row {
  grid-template-columns: 80px 1fr;
  margin-bottom: 0;
  align-items: center;
}

#page .indicator-row-first,
#page .effect-row-first {
  margin-top: 12px;
}

#page .indicator-icon,
#page .metric-icon,
#page .trend-icon {
  height: 25px;
  position: relative;
  top: 5px;
}

#page .indicator-icon-offset-3 {
  top: 3px;
}

#page .score-icon {
  height: 50px;
  position: relative;
  top: 3px;
  right: 5px;
}

#page .balance-illustration {
  height: 103px;
  position: relative;
  top: 5px;
  left: 0;
}

#page .story-illustration {
  height: 150px;
  position: relative;
  top: 5px;
  left: 10px;
}


/* Tag-driven passage layouts (tb3).
   Passage tags select these article classes through StoryScript.
   Add the prose tag when a passage needs left-aligned reading text. */
#page article.passage-intro,
#page article.passage-round,
#page article.passage-event,
#page article.passage-ending,
#page article.passage-technology {
  text-align: center;
}

#page article.passage-explanation,
#page article.passage-policy,
#page article.passage-outcome,
#page article.passage-prose {
  text-align: left;
}

#page article .passage-title,
#page article .passage-navigation {
  text-align: center;
}

/* Indicator descriptions stay readable inside centered passage types. */
#page article .indicator-row,
#page article .effect-row,
#page article .summary-row {
  text-align: left;
}


/* Title typography and ending details (tb5). */
#page article .passage-title,
#page article .game-over-label {
  font-weight: bold;
}

#page header .header-title {
  font-size: 20px;
  font-weight: bold;
}

#page article .ending-assessment {
  text-align: center;
}

#page article .score-details-link {
  font-size: 15px;
  text-align: right;
}

/* Shared header/footer interface (tb8). */
#page .ui-identity {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
}

#page .ui-logo {
  height: 50px;
}

#page .ui-title-group {
  display: inline-block;
  line-height: 0.9;
}

#page .ui-subtitle {
  font-size: 12px;
}

#page .ui-status,
#page .ui-metric,
#page .ui-controls,
#page .ui-controls > p {
  display: flex;
  align-items: center;
  gap: 8px;
}

#page .ui-status {
  flex-wrap: wrap;
  gap: 20px;
}

#page .ui-metric {
  white-space: nowrap;
}

#page .ui-controls,
#page .ui-controls > p {
  flex-wrap: wrap;
  justify-content: center;
  gap: 16px;
  margin: 0;
}

#page header .right .ui-controls,
#page footer .right .ui-status {
  justify-content: flex-end;
}


/* Passage illustrations and remaining body layout (tb9). */
#page .welcome-illustration {
  left: auto;
  right: 1px;
}

#page .research-result-illustration {
  left: auto;
  right: 10px;
}

#page .research-illustration,
#page .policy-illustration {
  position: relative;
  top: 5px;
}

#page .research-illustration {
  height: 117px;
}

#page .policy-illustration {
  height: 110px;
  left: 10px;
}

#page .score-chart {
  height: 250px;
}

#page .explanation-icon,
#page .explanation-link-icon {
  position: relative;
  top: 5px;
}

#page .explanation-icon {
  height: 50px;
}

#page .explanation-link-icon {
  height: 25px;
  right: 15px;
}

#page .explanation-happiness-link-icon {
  right: 12px;
  margin-right: 10px;
}

#page .game-over-heading-icon,
#page .game-over-icon,
#page .game-over-budget-icon {
  height: 50px;
  position: relative;
  top: 20px;
}

#page .game-over-heading-icon {
  top: 10px;
}

#page .game-over-budget-icon {
  height: 70px;
}

#page .credits-funding {
  font-size: 12px;
  line-height: 1.5;
  margin: 0;
  position: relative;
  top: 40px;
}

#page .illustration-group,
#page .research-choice {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex-wrap: wrap;
  gap: 24px;
  max-width: 100%;
}

#page .research-choice {
  gap: 16px;
}
