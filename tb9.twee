</div>


:: BYOD [policy] {"position":"1250,950","size":"100,100"}
circle: circle + 1
money: money - 1
randomEvent: (Math.floor((Math.random() * 1000 + Date.now()) % 4)) +1
--
<div class="passage-title">
BYOD
</div>

{effect row: "circularity", trend: "up", text: "the number of devices in use is reduced", first: true}

{effect row: "happiness", trend: "unchanged", text: "people are slightly happier because they only need one phone (too little to affect the index)"}

{effect row: "budget", trend: "down", text: "implementation costs and lower tax revenue from reduced device sales"}

<div class="passage-navigation">
[if randomEvent == 1]
[[Continue->Event2.1]]

[if randomEvent == 2]
[[Continue->Event2.2]]

[if randomEvent == 3]
[[Continue->Event2.3]]

[if randomEvent > 3]
[[Continue->Round4]]

[continue]
{game over override}
</div>


:: CLOSED-LOOP LAW [policy] {"position":"1150,1775","size":"100,100"}
circle: circle + 1
--
<div class="passage-title">
CLOSED-LOOP LAW
</div>

{effect row: "circularity", trend: "up", text: "more materials are recovered and reused in new devices", first: true}

{effect row: "happiness", trend: "unchanged", text: "the policy has little direct impact on consumers"}

<div class="passage-navigation">
[if tech > 0]
[[Continue->NewTech3]]

[if tech == 0]
[[Continue->End1]]

[continue]
{game over override}
</div>


:: CONSUMPTION LIMIT [policy] {"position":"1375,1500","size":"100,100"}
happy: happy - 2
circle: circle + 2
money: money - 1
--
<div class="passage-title">
NO EXPLOITATIVE FEATURES
</div>

{effect row: "circularity", trend: "up", text: "phones are kept and used for longer", first: true}

{effect row: "happiness", trend: "down", text: "people have less freedom to upgrade whenever they want"}

{effect row: "budget", trend: "down", text: "fewer phones are sold, resulting in lower tax revenue"}

<div class="passage-navigation">
[if tech > 0]
[[Continue->NewTech2]]

[if tech == 0]
[[Continue->Round6]]

[continue]
{game over override}
</div>


