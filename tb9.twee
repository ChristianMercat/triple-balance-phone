:: 1.1Fire [outcome] {"position":"1700,575","size":"100,100"}
circle: Math.max(0, circle - 1)
--
<div class="passage-title">
The recycling plant burns down.
</div>

{effect row: "circularity", trend: "down", text: "less ability to recycle old smartphones and materials", first: true}

<div class="passage-navigation">
[[Continue->Round2]]

{game over override}
</div>


:: 1.1OutFire [outcome] {"position":"1575,575","size":"100,100"}
money: money - 1
--
<div class="passage-title">
You managed to stop the fire.
</div>

{effect row: "circularity", trend: "unchanged", text: "thanks to your action, the circularity did not decrease", first: true}

{effect row: "budget", trend: "down", text: "the operation was paid from the city budget"}

<div class="passage-navigation">
[[Continue->Round2]]

{game over override}
</div>


:: 1.2bankrupt [outcome] {"position":"2025,575","size":"100,100"}
circle: Math.max(0, circle - 1)
happy: happy - 1
--
<div class="passage-title">
The supplier goes bankrupt.
</div>

{effect row: "circularity", trend: "down", text: "fewer phones are repaired and kept in use", first: true}

{effect row: "happiness", trend: "down", text: "repairs become more expensive and inconvenient"}

<div class="passage-navigation">
[[Continue->Round2]]

{game over override}
</div>


:: 1.2save [outcome] {"position":"1900,575","size":"100,100"}
money: money - 1
--
<div class="passage-title">
Your aid keeps the supplier operating.
</div>

{effect row: "circularity", trend: "unchanged", text: "thanks to your action, the circularity did not decrease", first: true}

{effect row: "budget", trend: "down", text: "financial aid was paid from the city budget"}

<div class="passage-navigation">
[[Continue->Round2]]

{game over override}
</div>


:: 1.3minimalism [outcome] {"position":"2300,575","size":"100,100"}
circle: circle + 1
money: money - 1
--
<div class="passage-title">
People own fewer devices.
</div>

{effect row: "circularity", trend: "up", text: "fewer new phones are needed", first: true}

{effect row: "budget", trend: "down", text: "less tax revenue"}

<div class="passage-navigation">
[[Continue->Round2]]

{game over override}
</div>


:: 1.3spending [outcome] {"position":"2175,575","size":"100,100"}
money: money - 1
--
<div class="passage-title">
You promote new technology and upgrades.
</div>

{effect row: "circularity", trend: "unchanged", text: "the positive effect is cancelled out by your actions", first: true}

{effect row: "budget", trend: "down", text: "money from the city budget was used"}

<div class="passage-navigation">
[[Continue->Round2]]

{game over override}
</div>


:: 2.1Reduce [outcome] {"position":"1800,1075","size":"100,100"}
happy: happy - 1
--
<div class="passage-title">
You restrict the launch of the new Pineapple Phone.
</div>

{effect row: "circularity", trend: "unchanged", text: "not too many phones in use are replaced with the new model", first: true}

{effect row: "happiness", trend: "down", text: "people are disappointed they cannot easily get the newest features"}

<div class="passage-navigation">
[[Continue->Round4]]

{game over override}
</div>


:: 2.1Support [outcome] {"position":"1650,1075","size":"100,100"}
happy: happy + 1
circle: Math.max(0, circle - 1)
money: money + 1
--
<div class="passage-title">
Unrestricted launch of the new Pineapple Phone
</div>

{effect row: "circularity", trend: "down", text: "more old phones are replaced sooner", first: true}

{effect row: "happiness", trend: "up", text: "latest technology is available"}

{effect row: "budget", trend: "up", text: "more new phones are sold, which generates additional tax revenue"}

<div class="passage-navigation">
[[Continue->Round4]]

{game over override}
</div>


:: 2.2cheap [outcome] {"position":"1925,1075","size":"100,100"}
happy: happy + 1
circle: Math.max(0, circle - 1)
money: money - 1
--
<div class="passage-title">
New phones are cheap.
</div>

{effect row: "circularity", trend: "down", text: "older devices are replaced more quickly", first: true}

{effect row: "happiness", trend: "up", text: "lower phone prices"}

{effect row: "budget", trend: "down", text: "less tax is paid to the city, since products are cheaper"}

<div class="passage-navigation">
[[Continue->Round4]]

{game over override}
</div>


:: 2.2protect [outcome] {"position":"2050,1075","size":"100,100"}
happy: happy - 1
money: money + 1
--
<div class="passage-title">
You added tax to the cheap phones.
</div>

{effect row: "circularity", trend: "unchanged", text: "people buy as many phones as before", first: true}

{effect row: "happiness", trend: "down", text: "new tax"}

{effect row: "budget", trend: "up", text: "additional tax revenue"}

<div class="passage-navigation">
[[Continue->Round4]]

{game over override}
</div>


:: 2.3RR [outcome] {"position":"2225,1075","size":"100,100"}
happy: happy - 1
circle: circle + 2
money: money -1
--
<div class="passage-title">
You encourage citizens to repair, reuse, and buy refurbished phones.
</div>

{effect row: "circularity", trend: "up", text: "fewer new phones are purchased", first: true}

{effect row: "happiness", trend: "down", text: "lack of new devices"}

{effect row: "budget", trend: "down", text: "the campaign used money from the city budget"}

<div class="passage-navigation">
[[Continue->Round4]]

{game over override}
</div>


:: 2.3subsidize [outcome] {"position":"2350,1075","size":"100,100"}
money: Math.max(0, money - 2)
--
<div class="passage-title">
You subsidize new phone purchases.
</div>

{effect row: "happiness", trend: "unchanged", text: "people remain as happy as before the chip crisis", first: true}

{effect row: "budget", trend: "down", text: "money from the city budget is used"}

<div class="passage-navigation">
[[Continue->Round4]]

{game over override}
</div>


:: 3.1regulate [outcome] {"position":"1775,1350","size":"100,100"}
circle: Math.max(0, circle - 1)
--
<div class="passage-title">
You require safer recycling methods and waste treatment.
</div>

{effect row: "circularity", trend: "down", text: "fewer materials are processed in the short term", first: true}

{effect row: "happiness", trend: "unchanged", text: "your measures prevent a change in happiness"}

{effect row: "budget", trend: "unchanged", text: "recycling costs increase, but the city budget remains unchanged"}

<div class="passage-navigation">
[[Continue->Round5]]

{game over override}
</div>


:: 3.1toxic [outcome] {"position":"1650,1350","size":"100,100"}
happy: happy - 1
money: money - 1
--
<div class="passage-title">
Recycling operations keep running despite the risks.
</div>

{effect row: "circularity", trend: "unchanged", text: "materials are still recycled", first: true}

{effect row: "happiness", trend: "down", text: "toxic waste harms the environment and public health"}

{effect row: "budget", trend: "down", text: "increased illness places a financial burden on the city budget"}

<div class="passage-navigation">
[[Continue->Round5]]

{game over override}
</div>


:: 3.2info [outcome] {"position":"2075,1350","size":"100,100"}
circle: circle + 1
happy: happy + 1
money: money -1
--
<div class="passage-title">
You launched a public information campaign.
</div>

{effect row: "circularity", trend: "up", text: "more phones are donated, reused, and recycled", first: true}

{effect row: "happiness", trend: "up", text: "people feel more secure about their personal information (even more than before the event)"}

{effect row: "budget", trend: "down", text: "the campaign used money from the city budget"}

<div class="passage-navigation">
[[Continue->Round5]]

{game over override}
</div>


:: 3.2nothing [outcome] {"position":"1950,1350","size":"100,100"}
circle: Math.max(0, circle - 1)
happy: happy - 1
--
<div class="passage-title">
People are afraid to give away or recycle old devices.
</div>

{effect row: "circularity", trend: "down", text: "fewer phones are reused, repaired, or recycled", first: true}

{effect row: "happiness", trend: "down", text: "fear of data theft"}

<div class="passage-navigation">
[[Continue->Round5]]

{game over override}
</div>


:: 3.3circular [outcome] {"position":"2225,1350","size":"100,100"}
circle: circle + 2
money: money - 1
--
<div class="passage-title">
You provide incentives for repair, reuse, and refurbishment.
</div>

{effect row: "circularity", trend: "up", text: "phones and components stay in use longer", first: true}

{effect row: "happiness", trend: "unchanged", text: "affordable devices are accessible despite the recession"}

{effect row: "budget", trend: "down", text: "incentives are paid from the city budget"}

<div class="passage-navigation">
[[Continue->Round5]]

{game over override}
</div>


:: 3.3purchase [outcome] {"position":"2350,1350","size":"100,100"}
money: money - 1
--
<div class="passage-title">
You offer vouchers and tax reductions for new phones.
</div>

{effect row: "circularity", trend: "unchanged", text: "replacement rates stay the same", first: true}

{effect row: "happiness", trend: "unchanged", text: "people still have access to new devices despite the recession"}

{effect row: "budget", trend: "down", text: "vouchers or tax reductions are paid from the city budget"}

<div class="passage-navigation">
[[Continue->Round5]]

{game over override}
</div>


:: BIO PHONE [policy] {"position":"1125,1500","size":"100,100"}
circle: circle + 1
money: money - 1
--
<div class="passage-title">
BIO PHONE
</div>

{effect row: "circularity", trend: "up", text: "more environmentally friendly materials are used", first: true}

{effect row: "budget", trend: "down", text: "tax revenue is reduced"}

<div class="passage-navigation">
[if tech > 0]
[[Continue->NewTech2]]

[if tech == 0]
